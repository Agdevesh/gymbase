DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gymbase"
# Direct (non-pooled) URL for migrations; same as DATABASE_URL locally. Neon on Vercel sets both.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/gymbase"
AUTH_SECRET="change-me-to-a-long-random-string"
# Public URL used in links; optional on Vercel (derived from the project URL)
AUTH_URL="http://localhost:3000"
CRON_SECRET="change-me-too"
# Optional messaging providers for reminders; leave empty to send by hand from /reminders
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
RESEND_API_KEY=""
EMAIL_FROM=""
# GYMBASE subscription billing (Razorpay Subscriptions). Without keys, /billing shows plans but cannot take payment.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PLAN_STARTER=""
RAZORPAY_PLAN_GROWTH=""
RAZORPAY_PLAN_PRO=""
SUPPORT_EMAIL="support@gymbase.app"
