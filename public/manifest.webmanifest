{
  "name": "GYMBASE",
  "short_name": "GYMBASE",
  "description": "Gym check-in, members, inquiries and payments",
  "id": "/",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fafafa",
  "theme_color": "#171717",
  "lang": "en-IN",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Check-in", "url": "/checkin", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Members", "url": "/members", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Inquiries", "url": "/leads", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
