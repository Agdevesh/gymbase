// GYMBASE schema. Every tenant-owned row carries gymId; all money is integer paise.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Tenancy & auth ----------

enum Role {
  OWNER
  RECEPTION
  TRAINER
  MEMBER
}

model Gym {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  phone       String?
  email       String?
  address     String?
  gstin       String?
  currency    String   @default("INR")
  timezone    String   @default("Asia/Kolkata")
  memberSeq   Int      @default(0) // last number used for Member.code
  invoiceSeq  Int      @default(0) // last number used for Invoice.number
  gstPercent  Int      @default(0) // applied to new invoices, e.g. 18
  logoUrl     String?
  openTime    String? // "06:00"
  closeTime   String? // "22:00"
  weeklyOff   String? // e.g. "Sunday"
  holidays    String[] @default([]) // "2026-10-20 Diwali"
  upiId       String? // for UPI pay links / QR on receipts
  upiAlertToken String? @unique // secret in the bank-SMS webhook URL (/api/upi/alerts/<token>)
  receiptNote String? // footer on invoices and receipts
  whatsapp    String? // gym's WhatsApp number shown to members
  setupDoneAt DateTime? // owner dismissed the getting-started checklist
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  invites       Invite[]
  members       Member[]
  plans         Plan[]
  memberships   Membership[]
  checkIns      CheckIn[]
  leads         Lead[]
  payments      Payment[]
  invoices      Invoice[]
  cashClosings  CashClosing[]
  reminders     Reminder[]
  reminderRules ReminderRule[]
  staffAttend   StaffAttendance[]
  ptAssignments PtAssignment[]
  commissions   Commission[]
  subscription  Subscription?
  upiRequests   UpiRequest[]
  bankAlerts    BankAlert[]
  files         StoredFile[]
  auditLogs     AuditLog[]
  measurements  Measurement[]
  fitnessPlans  FitnessPlan[]
  lockers       Locker[]
  classes       GymClass[]
  classBookings ClassBooking[]
  ptSlots       PtSlot[]
  expenses      Expense[]
}

model User {
  id           String   @id @default(cuid())
  gymId        String
  gym          Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  email        String
  name         String
  passwordHash String
  role         Role
  phone        String?
  active       Boolean  @default(true)
  commissionPercent Int @default(0) // trainer's cut of PT fees
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ptSessionsLed   PtSession[]
  member          Member?
  invitesSent     Invite[]
  checkInsLogged  CheckIn[]        @relation("CheckInBy")
  paymentsTaken   Payment[]        @relation("PaymentBy")
  upiRequests     UpiRequest[]     @relation("UpiRequestBy")
  leadsAssigned   Lead[]           @relation("LeadOwner")
  cashClosings    CashClosing[]
  staffAttendance StaffAttendance[]
  ptAssignments   PtAssignment[]   @relation("Trainer")
  commissions     Commission[]
  memberNotes     MemberNote[]
  passwordResets  PasswordReset[]
  auditLogs       AuditLog[]
  measurementsTaken Measurement[]
  fitnessPlansWritten FitnessPlan[]
  classesLed      GymClass[]
  ptSlotsLed      PtSlot[]         @relation("SlotTrainer")
  expensesAdded   Expense[]

  @@unique([gymId, email])
  @@index([gymId, role])
}

model Invite {
  id         String    @id @default(cuid())
  gymId      String
  gym        Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  email      String
  role       Role
  token      String    @unique
  invitedBy  String
  inviter    User      @relation(fields: [invitedBy], references: [id])
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([gymId])
}

// ---------- Members ----------

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Member {
  id             String    @id @default(cuid())
  gymId          String
  gym            Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  code           String // short human id shown on cards, e.g. GB-0042
  qrToken        String    @unique
  firstName      String
  lastName       String?
  phone          String
  email          String?
  gender         Gender?
  dob            DateTime?
  photoUrl       String?
  address        String?
  emergencyName  String?
  emergencyPhone String?
  notes          String?
  usualTime      String? // when they normally come, free text like "Morning 6-8"
  userId         String?   @unique
  user           User?     @relation(fields: [userId], references: [id])
  leadId         String?   @unique
  lead           Lead?     @relation(fields: [leadId], references: [id])
  joinedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  documents     MemberDocument[]
  noteLog       MemberNote[]
  memberships   Membership[]
  checkIns      CheckIn[]
  payments      Payment[]
  invoices      Invoice[]
  upiRequests   UpiRequest[]
  reminders     Reminder[]
  ptAssignments PtAssignment[]
  measurements  Measurement[]
  fitnessPlans  FitnessPlan[]
  locker        Locker?
  classBookings ClassBooking[]
  ptSlots       PtSlot[]

  @@unique([gymId, code])
  @@unique([gymId, phone])
  @@index([gymId, firstName, lastName])
}

model MemberDocument {
  id        String      @id @default(cuid())
  memberId  String
  member    Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  label     String
  url       String
  fileId    String?     @unique
  file      StoredFile? @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
}

model MemberNote {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([memberId, createdAt])
}

// Uploaded photos and documents, kept in Postgres so the app needs no extra storage service.
// Served only through /api/files/[id], which checks gymId.
model StoredFile {
  id        String   @id @default(cuid())
  gymId     String
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  document MemberDocument?
  expense  Expense?

  @@index([gymId])
}

// ---------- Plans & memberships ----------

enum PlanType {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  PT
  CUSTOM
}

enum MembershipStatus {
  ACTIVE
  FROZEN
  EXPIRED
  CANCELLED
}

model Plan {
  id           String   @id @default(cuid())
  gymId        String
  gym          Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name         String
  type         PlanType
  durationDays Int
  pricePaise   Int
  ptSessions   Int? // for PT plans
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  memberships Membership[]

  @@index([gymId, active])
}

model Membership {
  id            String           @id @default(cuid())
  gymId         String
  gym           Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberId      String
  member        Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId        String
  plan          Plan             @relation(fields: [planId], references: [id])
  startDate     DateTime
  endDate       DateTime
  status        MembershipStatus @default(ACTIVE)
  pricePaise    Int
  discountPaise Int              @default(0)
  frozenAt      DateTime?
  frozenDays    Int              @default(0)
  cancelledAt   DateTime?
  cancelReason  String?
  renewedFromId String?          @unique
  renewedFrom   Membership?      @relation("Renewal", fields: [renewedFromId], references: [id])
  renewedTo     Membership?      @relation("Renewal")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  invoices      Invoice[]
  ptAssignments PtAssignment[]

  @@index([gymId, status, endDate])
  @@index([memberId])
}

// ---------- Entry / check-in ----------

enum CheckInSource {
  QR
  RECEPTION
  MANUAL
}

model CheckIn {
  id          String        @id @default(cuid())
  gymId       String
  gym         Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  checkedInAt DateTime      @default(now())
  checkedOutAt DateTime?
  source      CheckInSource
  loggedById  String?
  loggedBy    User?         @relation("CheckInBy", fields: [loggedById], references: [id])

  @@index([gymId, checkedInAt])
  @@index([gymId, checkedOutAt])
  @@index([memberId, checkedInAt])
}

// ---------- Inquiries / leads ----------

enum LeadSource {
  WALK_IN
  PHONE
  WHATSAPP
  INSTAGRAM
  WEB
  REFERRAL
  SOCIAL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  TRIAL
  NEGOTIATING
  CONVERTED
  LOST
}

model Lead {
  id           String     @id @default(cuid())
  gymId        String
  gym          Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  email        String?
  source       LeadSource
  status       LeadStatus @default(NEW)
  interestedIn String?
  notes        String?
  followUpAt   DateTime?
  ownerId      String?
  owner        User?      @relation("LeadOwner", fields: [ownerId], references: [id])
  lostReason   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  member    Member?
  reminders Reminder[]
  activity  LeadActivity[]

  @@index([gymId, status, followUpAt])
  @@index([gymId, phone])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  note      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

// ---------- Payments ----------

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK
  OTHER
}

enum PaymentKind {
  PAYMENT
  REFUND
}

model Invoice {
  id            String      @id @default(cuid())
  gymId         String
  gym           Gym         @relation(fields: [gymId], references: [id], onDelete: Cascade)
  number        String // per-gym sequence, e.g. INV-2026-0001
  memberId      String
  member        Member      @relation(fields: [memberId], references: [id])
  membershipId  String?
  membership    Membership? @relation(fields: [membershipId], references: [id])
  subtotalPaise Int
  gstPercent    Int         @default(0) // e.g. 18
  gstPaise      Int         @default(0)
  totalPaise    Int
  paidPaise     Int         @default(0)
  dueDate       DateTime?
  issuedAt      DateTime    @default(now())
  notes         String?
  publicToken   String?     @unique // shareable receipt link /r/<token>

  payments    Payment[]
  upiRequests UpiRequest[]

  @@unique([gymId, number])
  @@index([gymId, issuedAt])
  @@index([memberId])
}

model Payment {
  id          String        @id @default(cuid())
  gymId       String
  gym         Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member        @relation(fields: [memberId], references: [id])
  invoiceId   String?
  invoice     Invoice?      @relation(fields: [invoiceId], references: [id])
  kind        PaymentKind   @default(PAYMENT)
  method      PaymentMethod
  amountPaise Int
  reference   String? // UPI txn id, card last4, etc.
  takenById   String?
  takenBy     User?         @relation("PaymentBy", fields: [takenById], references: [id])
  paidAt      DateTime      @default(now())
  closingId   String?
  closing     CashClosing?  @relation(fields: [closingId], references: [id])
  refundOfId  String?
  refundOf    Payment?      @relation("Refund", fields: [refundOfId], references: [id])
  refunds     Payment[]     @relation("Refund")
  upiRequest  UpiRequest?

  @@index([gymId, paidAt])
  @@index([gymId, closingId])
}

model CashClosing {
  id            String   @id @default(cuid())
  gymId         String
  gym           Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  closedById    String
  closedBy      User     @relation(fields: [closedById], references: [id])
  expectedPaise Int
  countedPaise  Int
  notes         String?
  closedAt      DateTime @default(now())

  payments Payment[]

  @@unique([gymId, date])
}

// ---------- Reminders ----------

enum ReminderChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum ReminderType {
  RENEWAL
  DUES
  BIRTHDAY
  LEAD_FOLLOWUP
  PT_SESSION
  CUSTOM
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model Reminder {
  id          String          @id @default(cuid())
  gymId       String
  gym         Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  type        ReminderType
  channel     ReminderChannel
  status      ReminderStatus  @default(PENDING)
  memberId    String?
  member      Member?         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  to          String
  body        String
  scheduledAt DateTime
  sentAt      DateTime?
  error       String?
  providerRef String?
  dedupeKey   String?         @unique // type:target:day, so the daily generator never duplicates
  createdAt   DateTime        @default(now())

  @@index([gymId, status, scheduledAt])
}

// Per-gym rule for each reminder type: when to send, through which channel, with which text.
model ReminderRule {
  id         String          @id @default(cuid())
  gymId      String
  gym        Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  type       ReminderType
  channel    ReminderChannel
  enabled    Boolean         @default(true)
  daysBefore Int             @default(0) // renewal: days before expiry; dues: days after due date; others ignore
  template   String
  updatedAt  DateTime        @updatedAt

  @@unique([gymId, type])
}

// ---------- Staff & trainers ----------

model StaffAttendance {
  id        String    @id @default(cuid())
  gymId     String
  gym       Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime  @db.Date
  inAt      DateTime
  outAt     DateTime?

  @@unique([gymId, userId, date])
}

model PtAssignment {
  id            String   @id @default(cuid())
  gymId         String
  gym           Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainerId     String
  trainer       User     @relation("Trainer", fields: [trainerId], references: [id])
  membershipId  String?
  membership    Membership? @relation(fields: [membershipId], references: [id])
  feePaise      Int      @default(0)
  sessionsTotal Int
  sessionsUsed  Int      @default(0)
  startDate     DateTime
  endDate       DateTime?
  createdAt     DateTime @default(now())

  sessions    PtSession[]
  commissions Commission[]
  slots       PtSlot[]

  @@index([gymId, trainerId])
  @@index([memberId])
}

model PtSession {
  id           String       @id @default(cuid())
  assignmentId String
  assignment   PtAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  trainerId    String
  trainer      User         @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  at           DateTime     @default(now())
  notes        String?
  slot         PtSlot?

  @@index([assignmentId, at])
}

enum PtSlotStatus {
  SCHEDULED
  DONE
  NO_SHOW
  CANCELLED
}

// A booked PT time slot. Marking it DONE creates the PtSession that counts against the plan.
model PtSlot {
  id           String       @id @default(cuid())
  gymId        String
  gym          Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment   PtAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  trainerId    String
  trainer      User         @relation("SlotTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  at           DateTime
  durationMin  Int          @default(60)
  status       PtSlotStatus @default(SCHEDULED)
  notes        String?
  sessionId    String?      @unique
  session      PtSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())

  @@index([gymId, at])
  @@index([trainerId, at])
  @@index([memberId, at])
}

model Commission {
  id          String   @id @default(cuid())
  gymId       String
  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountPaise Int
  reason      String
  period      String // e.g. 2026-10
  paidAt      DateTime?
  ptAssignmentId String?
  ptAssignment   PtAssignment? @relation(fields: [ptAssignmentId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([gymId, userId, period])
}

// ---------- SaaS billing ----------

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Subscription {
  id          String             @id @default(cuid())
  gymId       String             @unique
  gym         Gym                @relation(fields: [gymId], references: [id], onDelete: Cascade)
  planCode    String             @default("starter") // starter | growth | pro
  status      SubscriptionStatus @default(TRIAL)
  memberLimit Int                @default(100)
  staffLimit  Int                @default(3)
  trialEndsAt DateTime
  renewsAt    DateTime?
  providerRef String? // Razorpay subscription id
  cancelAtPeriodEnd Boolean      @default(false)
  lastEventAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

// ---------- Settings, audit & security ----------

model AuditLog {
  id        String   @id @default(cuid())
  gymId     String
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // e.g. member.create, payment.refund
  entity    String // member | invoice | membership | ...
  entityId  String?
  summary   String
  createdAt DateTime @default(now())

  @@index([gymId, createdAt])
  @@index([gymId, entity, entityId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Fixed-window counters for login and reset throttling; works across serverless instances.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

// ---------- Progress, plans & lockers ----------

model Measurement {
  id           String   @id @default(cuid())
  gymId        String
  gym          Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  at           DateTime @default(now())
  weightKg     Float?
  heightCm     Float?
  bodyFatPct   Float?
  chestCm      Float?
  waistCm      Float?
  hipsCm       Float?
  armCm        Float?
  thighCm      Float?
  notes        String?
  recordedById String?
  recordedBy   User?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([memberId, at])
  @@index([gymId])
}

enum FitnessPlanType {
  DIET
  WORKOUT
}

model FitnessPlan {
  id        String          @id @default(cuid())
  gymId     String
  gym       Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type      FitnessPlanType
  title     String
  body      String
  active    Boolean         @default(true)
  authorId  String?
  author    User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([memberId, type, active])
  @@index([gymId])
}

model Locker {
  id         String    @id @default(cuid())
  gymId      String
  gym        Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  number     String
  memberId   String?   @unique
  member     Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  assignedAt DateTime?
  until      DateTime?
  feePaise   Int       @default(0)
  notes      String?

  @@unique([gymId, number])
}

// ---------- Group classes ----------

model GymClass {
  id          String   @id @default(cuid())
  gymId       String
  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name        String
  trainerId   String?
  trainer     User?    @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  weekdays    Int[] // 0 = Sunday … 6 = Saturday
  startTime   String // "07:00"
  durationMin Int      @default(60)
  capacity    Int      @default(20)
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  bookings ClassBooking[]

  @@index([gymId, active])
}

enum BookingStatus {
  BOOKED
  ATTENDED
  NO_SHOW
  CANCELLED
}

model ClassBooking {
  id        String        @id @default(cuid())
  gymId     String
  gym       Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  classId   String
  class     GymClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date      DateTime      @db.Date
  status    BookingStatus @default(BOOKED)
  createdAt DateTime      @default(now())

  @@unique([classId, memberId, date])
  @@index([gymId, date])
  @@index([memberId, date])
}

// ---------- Expenses ----------

enum ExpenseCategory {
  RENT
  SALARY
  ELECTRICITY
  EQUIPMENT
  MAINTENANCE
  MARKETING
  SUPPLIES
  OTHER
}

model Expense {
  id          String          @id @default(cuid())
  gymId       String
  gym         Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  amountPaise Int
  paidAt      DateTime
  method      PaymentMethod   @default(CASH)
  vendor      String?
  notes       String?
  receiptId   String?         @unique
  receipt     StoredFile?     @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())

  @@index([gymId, paidAt])
}

// A fixed-amount UPI QR shown for one invoice; verified by a bank alert (SMS forwarded to the webhook) or a UTR typed at reception.
enum UpiRequestStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

model UpiRequest {
  id          String           @id @default(cuid())
  gymId       String
  gym         Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amountPaise Int
  code        String // short reference in the QR note, e.g. GB-7K3M9Q
  token       String           @unique // public pay-page token (/pay/<token>)
  status      UpiRequestStatus @default(PENDING)
  utr         String?
  paymentId   String?          @unique
  payment     Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?            @relation("UpiRequestBy", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  paidAt      DateTime?
  createdAt   DateTime         @default(now())
  alerts      BankAlert[]

  @@unique([gymId, code])
  @@index([gymId, status, createdAt])
  @@index([invoiceId])
}

enum BankAlertSource {
  SMS
  EMAIL
  MANUAL
}

// Every bank credit alert that reached the webhook (or a UTR typed by staff), matched or not; UTR is unique per gym so a screenshot cannot be reused.
model BankAlert {
  id          String          @id @default(cuid())
  gymId       String
  gym         Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  source      BankAlertSource
  sender      String?
  text        String
  amountPaise Int?
  utr         String?
  payerVpa    String?
  requestId   String?
  request     UpiRequest?     @relation(fields: [requestId], references: [id], onDelete: SetNull)
  note        String? // why it was not matched
  receivedAt  DateTime        @default(now())

  @@unique([gymId, utr])
  @@index([gymId, receivedAt])
}
